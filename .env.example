# ===== 环境变量模板 =====
# 用法：cp .env.example .env.dev 后按需修改
# 注意：.env.* 已被 gitignore 排除，绝不提交；生产配置由部署平台注入环境变量

# 当前环境：dev / test / prod（决定读取哪个 .env.<ENVIRONMENT> 文件）
ENVIRONMENT=dev

# 调试开关（代码默认 False；开发环境显式开启）
DEBUG=true

VERSION=0.1.0
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# 加密密钥：本地随便填；生产必须由 secrets 注入（fail-fast 校验拒绝默认值）
SECRET_KEY=change-me-to-a-long-random-string-please

# ---- 数据库（拆成原始字段，连接串由代码自动拼装）----
DATABASE_TYPE=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=scaffold_dev
DATABASE_ECHO=false

# store 领域：待支付订单超时自动取消时限（分钟）
ORDER_TIMEOUT_MINUTES=30
REDIS_URL=redis://127.0.0.1:6380/0
# auth 领域：JWT 密钥（生产 fail-fast 校验，与 SECRET_KEY 同理）
JWT_SECRET=change-me-to-a-long-random-jwt-secret
